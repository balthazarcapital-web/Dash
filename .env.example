# Google Cloud OAuth 2.0 - somente no servidor/Vercel
# Leitura visual e embeddings da nova ferramenta de cotação (somente no servidor)
OPENAI_API_KEY=
QUOTATION_AI_MODEL=gpt-4.1

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Pasta usada para o estado compartilhado do dashboard (opcional; por padrão usa a raiz Deterlimp)
GOOGLE_DRIVE_STATE_FOLDER_ID=

# Opcional: raízes do Drive. Os IDs atuais continuam como padrão no servidor.
GOOGLE_DRIVE_ROOT_DETERLIMP=
GOOGLE_DRIVE_ROOT_CARLOS_BEZERRA=
GOOGLE_DRIVE_ROOT_DR_CLOVIS_CMFS=
GOOGLE_DRIVE_ROOT_CLINICA_GIANNA=

# Supabase (somente no servidor). Usado pela sincronização e pelos pedidos de mapa de cotação ao Bravo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Bucket privado dos arquivos de orçamento (padrão: cotacoes-orcamentos; ver supabase/migrations/002_cotacao_pedidos.sql)
COTACOES_BUCKET=

# Webhook do Bravo (somente no servidor). O token vai como "Authorization: Bearer <token>",
# ou com o nome de header definido em BRAVO_WEBHOOK_HEADER (valor cru, sem "Bearer").
BRAVO_WEBHOOK_URL=
BRAVO_WEBHOOK_TOKEN=
BRAVO_WEBHOOK_HEADER=
# Opcional: URL pública usada no callback_url (padrão: host da requisição)
DASH_PUBLIC_URL=
